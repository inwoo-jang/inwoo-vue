# 이 파일은 "어떤 키가 필요한지"만 알려 주는 견본입니다. 실제 값은 넣지 마세요.
#
# 쓰는 법
#   1) 이 파일을 .env.local 로 복사합니다   cp .env.example .env.local
#   2) .env.local 에 발급받은 키를 채웁니다
#   3) .env.local 은 .gitignore 의 *.local 에 걸려 Git 에 올라가지 않습니다
#
# ⚠️ 주의 — VITE_ 로 시작하는 값은 빌드할 때 번들 파일 안에 그대로 들어갑니다.
#    키를 넣은 채로 배포하면 dist/assets/*.js 를 열어 본 사람이 키를 볼 수 있습니다.
#    공개 배포본에는 키를 넣지 마세요. 키가 없으면 앱은 Open-Meteo 로 자동 전환됩니다.

# OpenWeather — 교안 7장에서 쓰는 현재 날씨 API (https://openweathermap.org/current)
# 없어도 앱은 동작합니다. 이 키가 없으면 Open-Meteo 가 대신 답합니다.
VITE_OPENWEATHER_API_KEY=

# OpenAI — 최종 결과물의 '운세' 메뉴에서 쓰는 AI 타로 해석 (개발 서버 전용)
# 화면에서 직접 넣을 수도 있습니다(그 값은 이 브라우저의 localStorage 에만 남습니다).
VITE_OPENAI_API_KEY=

# 타로 해석 프록시 주소. 비워 두면 같은 출처의 /api/tarot 를 씁니다.
# GitHub Pages 처럼 서버가 없는 곳에 올릴 때만 Vercel 주소를 적어 줍니다.
#   VITE_TAROT_PROXY=https://<프로젝트>.vercel.app/api/tarot
VITE_TAROT_PROXY=

# 로컬 mock API 주소 (npm run api 로 띄우는 상품 API, mock-api/server.js)
# 개발 서버에서만 씁니다. 비워 두면 같은 출처의 /api 를 씁니다.
# 배포본에 localhost 가 박히면 안 되므로 .env.production 등에는 넣지 마세요.
VITE_API_BASE=http://localhost:3001

# ── 서버(Vercel)에만 넣는 값 ───────────────────────────────────────
# 아래 두 개는 .env 가 아니라 Vercel 대시보드 → Settings → Environment
# Variables 에 넣습니다. VITE_ 를 붙이면 프런트 번들에 그대로 박히므로
# 절대 붙이지 마세요.
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_MODEL=gpt-4o-mini
