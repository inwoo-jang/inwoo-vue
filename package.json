    "deploy": "VITE_OPENWEATHER_API_KEY= npm run build && cp dist/index.html dist/404.html && touch dist/.nojekyll && npx --yes gh-pages@6 -d dist -b gh-pages --dotfiles -m \"deploy: $(date +%Y-%m-%d\\ %H:%M)\""
